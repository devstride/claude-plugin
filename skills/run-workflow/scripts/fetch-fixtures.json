    "name": "Pick up",
    "steps": [
     {
      "id": "claim",
      "name": "Claim it",
      "summary": "",
      "contract": "claim@1",
      "kind": "step",
      "run": {
       "source": "builtin",
       "ref": "claim-story",
       "version": null
      },
      "when": {
       "mode": "always",
       "condition": null
