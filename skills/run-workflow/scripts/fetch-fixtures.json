      "onFail": "stop"
     }
    ]
   }
  ]
 },
 "context": {
  "item": "I123",
  "mode": "named",
  "trigger": "item-picked-up"
 },
 "server": {
  "_readme": "What the tracker's own checks need to agree with these samples. workTypes is the item type every sample's appliesTo names, as it exists in the organization (the tracker refuses tags or repositories without an item type, narrower-without-work-type, and an item type it does not know). invalidCodes maps each invalidCode the runner gives to the code the tracker's definition check gives for the same definition: the tracker folds the runner's finer required-step codes into requires-weakened, and it refuses library skill steps and gate steps by name (deferred-librarySource, deferred-gates) until it supports them; once it accepts library skills, its library reference check refuses a step that names no published version instead. Every sample answer carries the organizationId the tracker sends, which the runner keeps for its library skill cache.",
  "workTypes": [
   {
    "id": "wt-acme-story",
    "archived": false
   }
  ],
  "invalidCodes": {
   "unknown-contract": "unknown-contract",
   "requires-missing": "requires-missing",
   "required-off": "requires-weakened",
   "library-version": "deferred-librarySource",
   "unsupported-gate": "deferred-gates"
  }
 },
 "errors": [
  "ABSENT",
  "FORBIDDEN",
  "UNREACHABLE",
  "ERROR"
 ],
