     "s-prog",
     "s-done"
    ]
   },
   {
    "id": "c-raid",
    "statusIds": [
     "s-new",
     "s-closed"
    ]
   },
   {
    "id": "c-sales",
    "statusIds": [
     "s-new",
     "s-act",
     "s-done"
    ]
   }
  ]
 },
