    "event": "landed",
    "item": {
     "number": "I101",
     "statusId": "s-prog"
    },
    "target": {
     "kind": "epic",
     "branch": "epic/I200-sync",
     "sha": "abc1234",
     "pullRequest": "https://github.com/o/r/pull/7",
     "releaseUnit": "I200 epic",
     "releaseTarget": "develop"
    }
   },
   "expect": {
    "statusId": "s-rev",
