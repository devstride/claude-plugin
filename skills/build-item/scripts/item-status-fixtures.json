  {
   "name": "start moves New to In Progress",
   "request": {
    "event": "start",
    "item": {
     "number": "I101",
     "statusId": "s-new"
    }
   },
   "expect": {
    "statusId": "s-prog",
    "statusName": "In Progress"
   }
  },
  {
   "name": "start with the item already In Progress moves nothing",
