  "statuses": [
   {
    "id": "s-new",
    "name": "New",
    "type": "new"
   },
   {
    "id": "s-disc",
    "name": "Discovery",
    "type": "custom"
   },
   {
    "id": "s-prog",
    "name": "In Progress",
    "type": "custom"
   },
   {
    "id": "s-rev",
    "name": "Review",
    "type": "custom"
   },
   {
    "id": "s-done",
    "name": "Done",
    "type": "done"
   },
   {
    "id": "s-pend",
    "name": "Pending Release",
    "type": "custom"
   },
   {
    "id": "s-closed",
    "name": "Closed",
    "type": "done"
   },
   {
    "id": "s-act",
    "name": "Active",
    "type": "custom"
   }
