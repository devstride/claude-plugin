{
  "schema": 1,
  "id": "build",
  "version": 1,
  "name": "Build",
  "startsWhen": "item-picked-up",
  "endsBy": null,
  "appliesTo": {
    "workTypes": [],
    "tags": [],
    "repositories": []
  },
  "minPluginVersion": "4.1.0",
  "phases": [
    {
      "id": "pick-up",
      "name": "Pick up",
      "steps": [
        {
          "id": "select",
          "name": "Select the story",
          "summary": "Choose the next unblocked item, check its spec against the code and resolve its delivery profile.",
          "contract": "select-item@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "build-item",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        },
        {
          "id": "claim",
          "name": "Claim it",
          "summary": "Claim the item so no other session builds it at the same time.",
          "contract": "claim-item@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "build-item",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        },
        {
          "id": "start",
          "name": "Mark In Progress",
          "summary": "Move the item to its in-progress status.",
          "contract": "start-item@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "build-item",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        }
      ]
    },
    {
      "id": "build",
      "name": "Build",
      "steps": [
        {
          "id": "branch",
          "name": "Branch",
          "summary": "Create the item's branch from its working base.",
          "contract": "branch@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "branch-feature",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        },
        {
          "id": "build",
          "name": "Build",
          "summary": "Understand the item, write the change and its tests, and get the local checks green.",
          "contract": "build@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "ultracode-build",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        },
        {
          "id": "risk-check",
          "name": "Story risk check",
          "summary": "Check the finished change for risks before it is handed to review.",
          "contract": "risk-check@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "ultracode-build",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        }
      ]
    },
    {
      "id": "review",
      "name": "Review",
      "steps": [
        {
          "id": "review-local",
          "name": "Local review",
          "summary": "Run the configured local review and fix what it finds.",
          "contract": "review@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "review",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        },
        {
          "id": "local-checks",
          "name": "Required local checks",
          "summary": "Run the required local checks that gate a merge with no pull request.",
          "contract": "local-checks@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "build-item",
            "version": null
          },
          "when": {
            "mode": "condition",
            "condition": "review-path:fast"
          },
          "onFail": "stop"
        },
        {
          "id": "pull-request-review",
          "name": "Pull request, review and CI",
          "summary": "Open the pull request, settle every reviewer and wait for CI to pass.",
          "contract": "pull-request-review@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "pr",
            "version": null
          },
          "when": {
            "mode": "condition",
            "condition": "review-path:pull-request"
          },
          "onFail": "stop"
        }
      ]
    },
    {
      "id": "land",
      "name": "Land",
      "steps": [
        {
          "id": "merge",
          "name": "Merge",
          "summary": "Merge the change into its working base once nothing holds it.",
          "contract": "merge@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "build-item",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        },
        {
          "id": "complete",
          "name": "Completion ritual",
          "summary": "Record on the item what landed, where and when.",
          "contract": "complete-item@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "build-item",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        },
        {
          "id": "file-findings",
          "name": "File untracked findings",
          "summary": "Turn every finding left without a home into a tracked item.",
          "contract": "file-findings@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "build-item",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        },
        {
          "id": "sync",
          "name": "Sync",
          "summary": "Return the checkout to its working base and report what remains.",
          "contract": "sync@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "build-item",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        }
      ]
    }
  ]
}
