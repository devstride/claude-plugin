{
  "schema": 1,
  "id": "build",
  "version": 2,
  "name": "Build",
  "startsWhen": "item-picked-up",
  "endsBy": null,
  "appliesTo": {
    "workTypes": [],
    "tags": [],
    "repositories": []
  },
  "minPluginVersion": "4.4.0",
  "phases": [
    {
      "id": "start",
      "name": "Start",
      "steps": [
        {
          "id": "claim",
          "name": "Claim the story",
          "summary": "The story is claimed so no other agent builds it at the same time.",
          "contract": "claim@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "claim-story",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        },
        {
          "id": "start",
          "name": "Mark in progress",
          "summary": "The item moves to its in-progress status before any branch exists.",
          "contract": "start@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "story-lifecycle",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        },
        {
          "id": "branch",
          "name": "Create the branch",
          "summary": "The story's branch is cut from its working base and pushed.",
          "contract": "branch@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "branch-feature",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        }
      ]
    },
    {
      "id": "build",
      "name": "Build",
      "steps": [
        {
          "id": "build",
          "name": "Build the change",
          "summary": "The change and its tests are written, with the quick checks green while building.",
          "contract": "build@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "ultracode-build",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        },
        {
          "id": "risk-check",
          "name": "Check for risk",
          "summary": "The finished change is checked for risk, and anything serious is fixed before review.",
          "contract": "risk-check@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "risk-check",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        },
        {
          "id": "local-checks",
          "name": "Run the local checks",
          "summary": "The complete local checks run once on the final change and leave a receipt.",
          "contract": "local-checks@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "local-checks",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        }
      ]
    },
    {
      "id": "review",
      "name": "Review",
      "steps": [
        {
          "id": "review",
          "name": "Review the change",
          "summary": "The change is reviewed, by the fast local review or the full pull request review, before it can merge.",
          "contract": "review@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "review-story",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        }
      ]
    },
    {
      "id": "land",
      "name": "Land",
      "steps": [
        {
          "id": "merge",
          "name": "Merge",
          "summary": "The reviewed and checked change lands on its working base once nothing holds it.",
          "contract": "merge@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "merge-story",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        },
        {
          "id": "complete",
          "name": "Complete the item",
          "summary": "The item records what landed, where and when.",
          "contract": "complete@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "story-lifecycle",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        },
        {
          "id": "capture",
          "name": "File follow-ups",
          "summary": "Findings left without a home become tracked items, and discovered scope joins the plan.",
          "contract": "capture@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "capture-findings",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        },
        {
          "id": "sync",
          "name": "Sync the checkout",
          "summary": "The checkout returns to its working base with a clean tree.",
          "contract": "sync@1",
          "kind": "step",
          "run": {
            "source": "builtin",
            "ref": "sync-base",
            "version": null
          },
          "when": {
            "mode": "always",
            "condition": null
          },
          "onFail": "stop"
        }
      ]
    }
  ]
}
