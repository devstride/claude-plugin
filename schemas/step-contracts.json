{
  "schema": 1,
  "contracts": {
    "claim@1": {
      "summary": "Claim the item so no other session builds it at the same time.",
      "builtinSkill": "claim-story",
      "payload": {
        "item": "context.item",
        "mode": "context.mode"
      },
      "argument": null,
      "verdict": {
        "label": "CLAIM",
        "values": [
          { "value": "WON", "detail": "none", "class": "continue" },
          { "value": "RENEWED", "detail": "none", "class": "continue" },
          { "value": "TOOK OVER", "detail": "none", "class": "continue" },
          { "value": "HELD", "detail": "required", "class": "end:held", "detailName": "holder" },
          { "value": "NOT CONFIGURED", "detail": "none", "class": "skipped" },
          { "value": "DEGRADED", "detail": "optional", "class": "skipped", "detailName": "reason" }
        ]
      },
      "result": {
        "required": ["state"],
        "types": {
          "state": "string",
          "heldBy": "string",
          "since": "string"
        }
      },
      "proof": {
        "binding": "none"
      },
      "requires": [],
      "claimPhase": null,
      "shipIntentStage": null
    },
    "start@1": {
      "summary": "Move the item to its in-progress status.",
