        "reviewMoment": "context.reviewMoment",
        "workingBase": "context.workingBase",
        "build": "result:build@1",
        "answer": "step.answer?",
        "previousProof": "step.passedProof?",
        "previousResult": "step.passedResult?",
        "baselineUnreadable": "step.passedUnreadable?"
