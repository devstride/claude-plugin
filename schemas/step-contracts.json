      "argument": null,
      "verdict": {
        "label": "START",
        "values": [
          { "value": "MOVED", "detail": "optional", "class": "continue", "detailName": "status" },
          { "value": "UNCHANGED", "detail": "none", "class": "continue" },
          { "value": "FAILED", "detail": "optional", "class": "stop", "detailName": "reason" }
        ]
      },
      "result": {
        "required": ["statusBefore", "statusAfter", "boardPlaced"],
