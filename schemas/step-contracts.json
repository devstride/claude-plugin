      "payload": {
        "item": "context.item?",
        "profile": "context.profile.name",
        "workingBase": "context.workingBase",
        "route": "context.route",
        "oneOff": "context.oneOff",
        "branch": "result:branch@1.branch",
        "previousProof": "step.proof?",
