      "result": {
        "required": ["ledger", "report", "counts", "untrackedDeferrals", "dismissed"],
        "types": {
          "ledger": "string",
          "report": "string",
          "counts": "object",
          "untrackedDeferrals": "array",
          "dismissed": "array",
          "deferrals": "array",
          "deviations": "array",
          "resolved": "array"
