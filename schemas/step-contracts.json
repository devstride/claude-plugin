      "argument": null,
      "verdict": {
        "label": "RISK CHECK",
        "values": [
          { "value": "CLEAR", "detail": "none", "class": "continue" },
          { "value": "FIXED", "detail": "optional", "class": "continue", "detailName": "count" },
          { "value": "NEEDS DECISION", "detail": "required", "class": "ask", "detailName": "question" },
          { "value": "BLOCKED", "detail": "optional", "class": "stop", "detailName": "reason" }
