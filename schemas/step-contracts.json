          "statusBefore": "string",
          "statusAfter": "string",
          "boardPlaced": "boolean"
        }
      },
      "proof": {
        "binding": "none"
      },
      "requires": [],
      "claimPhase": "Mark In Progress",
      "shipIntentStage": null
    },
    "branch@1": {
