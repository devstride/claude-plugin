{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A run event, as the step runner sends it",
  "description": "One entry of a run's add-only history, as skills/run-workflow/scripts/workflow.py journals it and sends it with the record_workflow_run_events tool. The tracker checks the same shape when it receives one. The tracker assigns the order (sequence), the time it recorded the event and who sent it; none of those is ever sent. Two more types, hold-lapsed and stop-requested, and the actor devstride are written only by the tracker and are refused from a client, so they are not listed here. Unknown payload keys are allowed and kept, so a newer runner can add an observation an older tracker stores without reading. Every number is a whole number.",
  "type": "object",
  "required": ["clientSequence", "type", "occurredAt", "actor", "payload"],
  "additionalProperties": false,
  "properties": {
    "clientSequence": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "type": { "$ref": "#/$defs/clientEventType" },
    "stepId": { "$ref": "#/$defs/stepId" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 50 },
    "occurredAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$" },
    "actor": { "enum": ["agent", "script", "person"] },
    "payload": { "type": "object" }
  },
  "oneOf": [
    { "required": ["payload"], "properties": { "type": { "const": "run-started" }, "payload": { "$ref": "#/$defs/runStarted" } } },
    { "required": ["stepId", "attempt"], "properties": { "type": { "const": "step-issued" }, "payload": { "$ref": "#/$defs/stepIssued" } } },
    { "required": ["stepId", "attempt"], "properties": { "type": { "const": "step-waiting" }, "payload": { "$ref": "#/$defs/stepWaiting" } } },
    { "required": ["stepId", "attempt"], "properties": { "type": { "const": "step-answered" }, "payload": { "$ref": "#/$defs/stepAnswered" } } },
    { "required": ["stepId", "attempt"], "properties": { "type": { "const": "step-decided" }, "payload": { "$ref": "#/$defs/stepDecided" } } },
    { "required": ["payload"], "properties": { "type": { "const": "run-stopped" }, "payload": { "$ref": "#/$defs/runStopped" } } },
    { "required": ["payload"], "properties": { "type": { "const": "run-resumed" }, "payload": { "$ref": "#/$defs/runResumed" } } },
    { "required": ["payload"], "properties": { "type": { "const": "run-rewound" }, "payload": { "$ref": "#/$defs/runRewound" } } },
    { "required": ["payload"], "properties": { "type": { "const": "run-adopted" }, "payload": { "$ref": "#/$defs/runAdopted" } } },
    { "required": ["payload"], "properties": { "type": { "const": "run-finished" }, "payload": { "$ref": "#/$defs/runFinished" } } }
  ],
  "$defs": {
    "clientEventType": {
      "enum": ["run-started", "step-issued", "step-waiting", "step-answered", "step-decided", "run-stopped", "run-resumed", "run-rewound", "run-adopted", "run-finished"]
    },
    "stepId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,99}$" },
    "line": { "type": "string", "minLength": 1, "maxLength": 200 },
    "nullableLine": { "type": ["string", "null"], "maxLength": 200 },
    "command": {
      "description": "Which runner command made the event: n counts the run's commands from 1, name is the command (start, next, done, wait, resume).",
      "type": "object",
      "required": ["n", "name"],
      "properties": { "n": { "type": "integer", "minimum": 1 }, "name": { "type": "string", "minLength": 1, "maxLength": 32 } }
    },
    "observed": {
      "description": "What the runner read from the machine during the command, on the command's first event only. Each key is present only when the command read it.",
      "type": "object",
      "properties": {
        "head": { "type": "string", "maxLength": 64 },
        "bindings": { "type": "object", "additionalProperties": { "enum": ["holds", "stale", "unreadable"] } },
        "readable": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "config": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": { "enum": ["read", "unreadable"] },
            "steps": { "type": "object", "additionalProperties": { "type": ["integer", "null"] } }
          }
        },
        "conditionFacts": {
          "type": "object",
          "properties": {
            "itemTags": { "type": "array", "items": { "type": "string" }, "maxItems": 200 },
            "workType": { "type": ["string", "null"] },
            "changedPaths": { "type": "array", "items": { "type": "string" }, "maxItems": 200 },
            "unknown": { "description": "The list facts the agent could not know (it sent null).", "type": "array", "items": { "type": "string" }, "maxItems": 10 }
          }
        },
        "repoSkill": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["state"],
            "properties": { "state": { "type": "string" }, "version": { "type": ["string", "null"] }, "hash": { "type": ["string", "null"] } }
          }
        },
        "library": { "type": "object", "additionalProperties": { "enum": ["hit", "miss", "unusable"] } }
      }
    },
    "ran": {
      "type": ["object", "null"],
      "required": ["source"],
      "properties": {
        "source": { "enum": ["builtin", "library", "repo", "off"] },
        "ref": { "type": ["string", "null"], "maxLength": 200 },
        "version": { "type": ["string", "null"], "maxLength": 200 },
        "hash": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "evidence": { "type": "array", "maxItems": 40, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": { "type": "string", "minLength": 1, "maxLength": 300 },
        "comment": { "type": "string", "maxLength": 500 },
        "commit": { "type": "string", "maxLength": 500 },
        "pullRequest": { "type": "string", "maxLength": 500 }
      }
    },
    "leftOut": {
      "description": "The payload keys the runner left out because the payload would have passed its size limit, in the order it dropped them.",
      "type": "array",
      "items": { "type": "string", "maxLength": 100 },
      "maxItems": 20
    },
    "runStarted": {
      "type": "object",
      "required": ["command", "workflow", "definitionHash", "catalogHash", "pluginVersion", "context"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "observed": { "$ref": "#/$defs/observed" },
        "workflow": {
          "type": "object",
          "required": ["id", "name", "version", "hash"],
          "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "version": { "type": "integer", "minimum": 1 }, "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
        },
        "definitionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "catalogHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pluginVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "definitionSource": { "type": ["string", "null"], "maxLength": 200 },
        "fallbackReason": { "type": ["string", "null"], "maxLength": 200 },
        "builtinId": { "type": ["string", "null"], "maxLength": 100 },
        "trackerOutcomes": { "type": ["array", "null"], "items": { "type": "string" }, "maxItems": 50 },
        "rehearsal": { "type": "boolean" },
        "carriedOver": { "description": "True when the run was already under way when its history began: started by an earlier plugin, or with the history switched off.", "type": "boolean" },
        "leftOut": { "$ref": "#/$defs/leftOut" },
        "skillManifest": { "type": "array", "maxItems": 40 },
        "replacedRunId": { "type": ["string", "null"], "maxLength": 64 },
        "context": {
          "description": "The run's context: item, goal, profile, workingBase, oneOff, route, releaseUnit, reviewMoment, branchSlug, mode, trigger, repository and the rollup verdict. Never cwd, a path on the machine.",
          "type": "object",
          "not": { "required": ["cwd"] }
        }
      }
    },
    "stepIssued": {
      "type": "object",
      "required": ["command", "action"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "observed": { "$ref": "#/$defs/observed" },
        "action": { "enum": ["run", "request-gate"] },
        "cause": { "enum": [null, "stale", "mismatch", "rewind", "redo", "changes", "reclaim"] },
        "autoRedo": { "type": "integer", "minimum": 0 },
        "agent": { "enum": [null, "routine", "judgement", "conversation"] },
        "ran": { "$ref": "#/$defs/ran" },
        "issuedHead": { "type": ["string", "null"], "maxLength": 64 },
        "refresh": { "type": ["boolean", "null"] },
        "superseded": { "description": "True when the cause is stale because an earlier step this one relies on ran again after it.", "type": "boolean" },
        "phase": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "stepWaiting": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "observed": { "$ref": "#/$defs/observed" },
        "reason": { "$ref": "#/$defs/nullableLine" }
      }
    },
    "stepAnswered": {
      "type": "object",
      "required": ["command", "verdictLine", "status"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "observed": { "$ref": "#/$defs/observed" },
        "verdictLine": { "$ref": "#/$defs/line" },
        "value": { "type": ["string", "null"], "maxLength": 200 },
        "class": { "type": ["string", "null"], "maxLength": 100 },
        "status": { "enum": ["done", "failed", "skipped", "waiting", "parked", "open"] },
        "continued": { "type": "boolean" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "links": { "$ref": "#/$defs/links" },
        "result": { "type": ["object", "null"] },
        "proof": { "type": ["object", "null"] },
        "recordsOutcome": { "type": ["string", "null"], "maxLength": 32 },
        "fault": { "$ref": "#/$defs/nullableLine" },
        "checks": {
          "type": "object",
          "properties": {
            "binding": { "enum": ["holds", "mismatch", "unchecked", "unreadable"] },
            "resultUnreadable": { "type": "string", "maxLength": 200 }
          }
        },
        "repaired": { "type": "boolean" },
        "accepted": { "description": "A confirm verdict the person answered: true for yes, false for no.", "type": "boolean" },
        "leftOut": { "$ref": "#/$defs/leftOut" },
        "gate": {
          "type": ["object", "null"],
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 100 },
            "since": { "type": ["string", "null"], "maxLength": 40 },
            "status": { "enum": ["approved", "changes", "rejected", "withdrawn", "done", "skipped"] }
          }
        }
      }
    },
    "stepDecided": {
      "type": "object",
      "required": ["command", "decision", "verdictLine"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "observed": { "$ref": "#/$defs/observed" },
        "decision": { "enum": ["off", "skipped-by-condition", "decided-from-config", "payload-missing", "skill-unusable"] },
        "verdictLine": { "$ref": "#/$defs/line" },
        "configRule": { "type": ["integer", "null"], "minimum": 0 },
        "evidence": { "$ref": "#/$defs/evidence" },
        "result": { "type": ["object", "null"] },
        "missingKey": { "type": "string", "maxLength": 200 },
        "code": { "type": "string", "maxLength": 100 },
        "status": { "description": "The step as the decision left it.", "enum": ["done", "failed", "skipped"] },
        "class": { "type": ["string", "null"], "maxLength": 100 },
        "continued": { "description": "True for a failed step the run goes on past.", "type": "boolean" },
        "leftOut": { "$ref": "#/$defs/leftOut" },
        "ran": { "$ref": "#/$defs/ran" }
      }
    },
    "runStopped": {
      "type": "object",
      "required": ["command", "kind", "reason"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "observed": { "$ref": "#/$defs/observed" },
        "kind": { "enum": ["failed", "needs-person", "no-verdict", "proof", "attempts-exhausted"] },
        "reason": { "$ref": "#/$defs/line" },
        "stepId": { "type": ["string", "null"], "maxLength": 100 },
        "confirm": { "type": "boolean" },
        "mayHaveLanded": { "type": "boolean" },
        "trackerOutcome": { "description": "How the tracker's run table names this stop as an ending, or null for a stop that waits for a person and leaves the run open.", "type": ["string", "null"], "maxLength": 32 },
        "commit": { "type": ["string", "null"], "maxLength": 64 }
      }
    },
    "runResumed": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "observed": { "$ref": "#/$defs/observed" },
        "answer": { "type": ["string", "null"], "maxLength": 2000 },
        "confirm": { "enum": [null, "yes", "no"] },
        "landed": { "const": false },
        "close": { "type": "boolean" }
      }
    },
    "runRewound": {
      "type": "object",
      "required": ["command", "fromStepId", "toStepId"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "observed": { "$ref": "#/$defs/observed" },
        "fromStepId": { "$ref": "#/$defs/stepId" },
        "toStepId": { "$ref": "#/$defs/stepId" },
        "contract": { "type": ["string", "null"], "maxLength": 100 },
        "resetStepIds": { "type": "array", "items": { "$ref": "#/$defs/stepId" }, "maxItems": 480 }
      }
    },
    "runAdopted": {
      "type": "object",
      "required": ["command", "toSessionId"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "observed": { "$ref": "#/$defs/observed" },
        "fromSessionId": { "type": ["string", "null"], "maxLength": 200 },
        "toSessionId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "branch": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "runFinished": {
      "type": "object",
      "required": ["command", "outcome", "trackerOutcome"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "observed": { "$ref": "#/$defs/observed" },
        "outcome": { "type": "string", "minLength": 1, "maxLength": 64 },
        "trackerOutcome": { "description": "The ending the tracker's run table records: one it knows, or the whole batch is refused.", "enum": ["completed", "failed", "interrupted", "ended-early", "landed", "handed-up", "shipped"] },
        "recordedOutcome": { "type": ["string", "null"], "maxLength": 32 },
        "continuedPastFailures": {
          "type": "array",
          "maxItems": 480,
          "items": { "type": "object", "required": ["stepId"], "properties": { "stepId": { "type": "string" }, "verdict": { "type": ["string", "null"] } } }
        },
        "openCheckpoints": {
          "type": "array",
          "maxItems": 480,
          "items": { "type": "object", "required": ["stepId"], "properties": { "stepId": { "type": "string" }, "gateId": { "type": ["string", "null"] } } }
        },
        "skippedByCondition": { "type": "array", "items": { "type": "string" }, "maxItems": 480 }
      }
    }
  }
}
